# Local Development Environment Variables
# Copy this to .env and fill with your values

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (for local development, SQLite is used by default)
# For PostgreSQL, uncomment and set:
# DATABASE_URL=postgresql://user:password@localhost:5432/hotel_booking_project

# Render
# These are set automatically on Render
# RENDER=true
# RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com
